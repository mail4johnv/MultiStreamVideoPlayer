<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MultiStreamVideoPlayer.Controls">

    <Style TargetType="{x:Type controls:TimelineControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="MaxHeight" Value="150" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TimelineControl}">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Left Section: Labels Header (Empty) -->
                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Background="#f0f2f5"
                                    BorderBrush="#dee2e6"
                                    BorderThickness="0,0,1,1" />

                            <!-- Right Section: Time Indicator Area -->
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    BorderBrush="#dee2e6"
                                    BorderThickness="0,0,0,1">
                                <Canvas x:Name="PART_TimeIndicatorCanvas"
                                        Background="#f8f9fa"
                                        ClipToBounds="True" />
                            </Border>

                            <!-- Left Section: Labels Canvas -->
                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    BorderBrush="#dee2e6"
                                    BorderThickness="0,0,1,0"
                                    Background="#f0f2f5">
                                <Canvas x:Name="PART_LabelsCanvas"
                                        ClipToBounds="True"
                                        Background="Transparent" />
                            </Border>

                            <!-- Right Section: Scrollable Tracks Area -->
                            <ScrollViewer x:Name="PART_ScrollViewer"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <Grid>
                                    <!-- Tracks Canvas -->
                                    <Canvas x:Name="PART_TracksCanvas"
                                            ClipToBounds="True"
                                            Background="Transparent" />

                                    <!-- Playhead Line -->
                                    <Line x:Name="PART_PlayheadLine"
                                          Stroke="#e74c3c"
                                          StrokeThickness="2"
                                          Panel.ZIndex="999" />

                                    <!-- Playhead Circle -->
                                    <Ellipse x:Name="PART_PlayheadCircle"
                                             Width="12"
                                             Height="12"
                                             Fill="#e74c3c"
                                             Cursor="Hand"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Panel.ZIndex="1000" />
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
