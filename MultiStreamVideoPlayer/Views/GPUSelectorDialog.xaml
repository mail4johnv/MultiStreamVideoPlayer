<Window x:Class="MultiStreamVideoPlayer.Views.GPUSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select GPU for Video Rendering" 
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="#F0F0F0"
        ShowInTaskbar="True">
    <Grid Margin="20" MinWidth="500">
        <StackPanel Orientation="Vertical" VerticalAlignment="Stretch">
            <!-- Title -->
            <TextBlock 
                Text="Available Graphics Processors" 
                FontSize="16" 
                FontWeight="Bold" 
                Foreground="#333333"
                Margin="0,0,0,15"/>
            
            <!-- Description -->
            <TextBlock 
                Text="Select a GPU for video decoding and rendering:" 
                FontSize="12" 
                Foreground="#666666"
                Margin="0,0,0,10"
                TextWrapping="Wrap"/>
            
            <!-- GPU List -->
            <ListBox 
                x:Name="GPUListBox" 
                Height="200"
                Margin="0,0,0,15"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8">
                            <StackPanel Orientation="Vertical">
                                <TextBlock 
                                    Text="{Binding Description}" 
                                    FontWeight="Bold"
                                    FontSize="12"
                                    Foreground="#000000"/>
                                <TextBlock 
                                    Text="{Binding MemoryInfo}" 
                                    FontSize="11"
                                    Foreground="#666666"
                                    Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                <Button 
                    x:Name="OKButton" 
                    Content="OK" 
                    Width="80" 
                    Height="32"
                    Margin="0,0,10,0"
                    Background="#007ACC"
                    Foreground="White"
                    FontSize="12"
                    Click="OKButton_Click"
                    Cursor="Hand"/>
                <Button 
                    x:Name="CancelButton" 
                    Content="Cancel" 
                    Width="80" 
                    Height="32"
                    Background="#CCCCCC"
                    Foreground="#333333"
                    FontSize="12"
                    Click="CancelButton_Click"
                    Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
