<Window x:Class="MultiStreamVideoPlayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MultiStreamVideoPlayer.ViewModels"
        xmlns:converters="clr-namespace:MultiStreamVideoPlayer.Converters"
        xmlns:controls="clr-namespace:MultiStreamVideoPlayer.Controls"
        xmlns:models="clr-namespace:MultiStreamVideoPlayer.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Multi-Stream Video Player"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=vm:DesignTimeMainViewModel, IsDesignTimeCreatable=True}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:PlayPauseConverter x:Key="PlayPauseConverter" />
        <converters:PlayColorConverter x:Key="PlayColorConverter" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter" />
        <converters:FileNameConverter x:Key="FileNameConverter" />
        <converters:MuteIconConverter x:Key="MuteIconConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Side -->
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Multi-Stream Video Player"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock FontSize="14"
                               Foreground="{StaticResource TextBrush}"
                               Opacity="0.7">
                        <Run Text="(" />
                        <Run Text="{Binding VideoStreams.Count, Mode=OneWay}" />
                        <Run Text=" streams)" />
                    </TextBlock>
                </StackPanel>

                <!-- Right Side -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Content="📁 Load Files"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddStreamsCommand}"
                            Margin="0,0,12,0" />
                    <Button Content="🔍 Search by Time"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleSearchPanelCommand}"
                            Margin="0,0,12,0" />
                    <Button Content="🎮 Select GPU"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding SelectGPUCommand}"
                            ToolTip="Select GPU adapter for video rendering"
                            Margin="0,0,12,0" />
                    <Button Content="⚙️ Settings"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Video Grid -->
        <Grid Grid.Row="1">
            <!-- Load Files Button (Top-Left Corner) -->
            <!-- Video Streams Grid -->
            <ItemsControl ItemsSource="{Binding VideoStreams}"
                          Visibility="{Binding VideoStreams.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding GridRows}" Columns="{Binding GridColumns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}"
                                Margin="4"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Card Header -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource SecondaryBrush}"
                                        Padding="8,6"
                                        CornerRadius="6,6,0,0">
                                    <Grid>
                                        <TextBlock Text="{Binding CameraName}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="×"
                                                HorizontalAlignment="Right"
                                                Width="24"
                                                Height="24"
                                                FontSize="20"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource TextBrush}"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.RemoveStreamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>

                                <!-- Video Area -->
                                <Grid Grid.Row="1" Background="{StaticResource BackgroundBrush}">
                                    <controls:NativeMediaPlayer Source="{Binding FilePath}"
                                                                SharpenStrength="{Binding DataContext.SharpenStrength, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                SharpenThreshold="{Binding DataContext.SharpenThreshold, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Tag="{Binding}"
                                                                Loaded="MediaElement_Loaded"
                                                                Unloaded="MediaElement_Unloaded" />

                                    <!-- No Video Overlay -->
                                    <Border Background="#99808080"
                                            Visibility="{Binding IsInGap, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="⏸"
                                                       FontSize="48"
                                                       Foreground="Gray"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,12" />
                                            <TextBlock Text="NO VIDEO"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Foreground="Gray"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,12" />
                                            <TextBlock Text="Playhead is in a gap"
                                                       FontSize="14"
                                                       Foreground="#AAAAAA"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Filename Display -->
                                    <TextBlock Text="{Binding FilePath, Converter={StaticResource FileNameConverter}}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextBrush}"
                                               Opacity="0.6"
                                               Margin="8"
                                               VerticalAlignment="Bottom"
                                               HorizontalAlignment="Left"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Timeline Section -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8,12,8">
            <Grid>
                <!-- Empty State -->
                <TextBlock Text="No timeline available"
                           FontSize="14"
                           Foreground="{StaticResource TextBrush}"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding VideoStreams.Count, Converter={StaticResource CountToVisibilityConverter}}" />

                <!-- Active Timeline -->
                <Grid Visibility="{Binding VideoStreams.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Audio & Playback Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Side: Volume Controls -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="{Binding IsMuted, Converter={StaticResource MuteIconConverter}}"
                                    Style="{StaticResource CircularButton}"
                                    Command="{Binding ToggleMuteCommand}"
                                    Width="24"
                                    Height="24"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Slider Width="100"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ModernSlider}" />

                                <TextBlock Text="Sharpen"
                                       Margin="14,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12" />
                                <Slider Width="110"
                                    Minimum="{Binding SharpenStrengthMin}"
                                    Maximum="{Binding SharpenStrengthMax}"
                                    SmallChange="0.01"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="False"
                                    Value="{Binding SharpenStrength, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ModernSlider}" />
                                    <TextBlock Text="{Binding SharpenStrength, StringFormat=F2}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="12"
                                           Width="34" />

                                <TextBlock Text="Threshold"
                                       Margin="10,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12" />
                                <Slider Width="110"
                                    Minimum="{Binding SharpenThresholdMin}"
                                    Maximum="{Binding SharpenThresholdMax}"
                                    SmallChange="0.001"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="False"
                                    Value="{Binding SharpenThreshold, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ModernSlider}" />
                                    <TextBlock Text="{Binding SharpenThreshold, StringFormat=F3}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="12"
                                           Width="38" />
                        </StackPanel>

                        <!-- Right Side: Playback Controls -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button Content="⏮"
                                    Style="{StaticResource CircularButton}"
                                    Command="{Binding PreviousCommand}"
                                    Width="28"
                                    Height="28"
                                    FontSize="14"
                                    Margin="0,0,8,0" />
                            <Button Content="{Binding IsPlaying, Converter={StaticResource PlayPauseConverter}}"
                                    Style="{StaticResource CircularButton}"
                                    Command="{Binding TogglePlayPauseCommand}"
                                    Width="36"
                                    Height="36"
                                    FontSize="18"
                                    Margin="0,0,8,0">
                                <Button.Background>
                                    <SolidColorBrush Color="{Binding IsPlaying, Converter={StaticResource PlayColorConverter}}" />
                                </Button.Background>
                            </Button>
                            <Button Content="⏭"
                                    Style="{StaticResource CircularButton}"
                                    Command="{Binding NextCommand}"
                                    Width="28"
                                    Height="28"
                                    FontSize="14" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Timeline Control -->
                    <controls:TimelineControl Grid.Row="1"
                                              VideoStreams="{Binding VideoStreams}"
                                              PlayheadPosition="{Binding PlayheadPosition, Mode=TwoWay}"
                                              TimelineStartTime="{Binding TimelineStartTime}"
                                              TimelineEndTime="{Binding TimelineEndTime}"
                                              IsPlaying="{Binding IsPlaying}"
                                              SeekRequested="TimelineControl_SeekRequested"
                                              Margin="0,0,0,6" />

                    <!-- Row 2: Time Display -->
                    <Grid Grid.Row="2">
                        <TextBlock Text="{Binding CurrentTime, StringFormat=hh\\:mm\\:ss}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding TotalDuration, StringFormat=hh\\:mm\\:ss}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Search Panel -->
        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Width="320"
                HorizontalAlignment="Right"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Panel.ZIndex="1000">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="20" ShadowDepth="0" />
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform X="320" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSearchPanelOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         To="0"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         To="320"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        Padding="20,16"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="Time Search"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <Button Content="×"
                                HorizontalAlignment="Right"
                                Width="20"
                                Height="20"
                                FontSize="18"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextBrush}"
                                Cursor="Hand"
                                Command="{Binding ToggleSearchPanelCommand}" />
                    </Grid>
                </Border>

                <!-- Form -->
                <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Date"
                                   FontSize="14"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="Medium"
                                   Margin="0,0,0,8" />
                        <DatePicker Style="{StaticResource ModernDatePicker}"
                                    Margin="0,0,0,16" />

                        <TextBlock Text="Time (HH:MM:SS)"
                                   FontSize="14"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="Medium"
                                   Margin="0,0,0,8" />
                        <TextBox Text="00:00:00"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,16" />

                        <TextBlock Text="Duration (minutes)"
                                   FontSize="14"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="Medium"
                                   Margin="0,0,0,8" />
                        <TextBox Text="5"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,16" />

                        <Button Content="Search"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,16" />

                        <Separator Background="{StaticResource BorderBrush}"
                                   Margin="0,8,0,16" />

                        <TextBlock Text="Recent Searches"
                                   FontSize="14"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="Medium"
                                   Margin="0,0,0,8" />
                        
                        <TextBlock Text="No recent searches"
                                   FontSize="12"
                                   Foreground="{StaticResource TextBrush}"
                                   Opacity="0.5"
                                   Margin="0,8" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
